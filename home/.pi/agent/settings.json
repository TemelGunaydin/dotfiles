{
  "images": {
    "blockImages": false
  },
  "terminal": {
    "showImages": false
  },
  "hideThinkingBlock": true,
  "quietStartup": true,
  "theme": "dark",
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "extensions": [
    "~/Projects/shorts-pipeline/.pi/extensions/workflow",
    "-builtin:mcp"
  ],
  "packages": [
    "npm:pi-open-agents",
    "npm:pi-session-import",
    "npm:pi-mcp-extension",
    "npm:pi-session-kit",
    "npm:pi-web-search",
    "npm:@ryan_nookpi/pi-extension-codex-fast-mode@0.2.6",
    "npm:pi-imagegen",
    "git:github.com/TemelGunaydin/terminal-todos@v1.5.1"
  ],
  "defaultModel": "gpt-6.1-sol",
  "defaultProvider": "openai-codex",
  "lastChangelogVersion": "1.2.0",
  "defaultThinkingLevel": "xhigh"
}